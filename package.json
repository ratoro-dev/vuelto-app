{
  "name": "rumbo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rumbo: gastos, presupuesto y metas sin conexión, sincronizados con el bot de WhatsApp",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor-mlkit/document-scanner": "^8.2.1",
    "@capacitor-mlkit/genai-prompt": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/geist": "^5.3.0",
    "@ionic/vue": "^9.0.6",
    "@ionic/vue-router": "^9.0.6",
    "@vue/devtools-api": "^8.2.1",
    "ionicons": "^8.1.0",
    "pinia": "^4.0.3",
    "vue": "3.5",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "8.5.2",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.1",
    "typescript": "5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
